              </svg>
              <svg xmlns=3D"http://www.w3.org/2000/svg" width=3D"100%" view=
Box=3D"0 0 32 32" fill=3D"none" class=3D"arrow-nav is-right">
                <path d=3D"M6.66663 16H25.3333" stroke=3D"#2B2220" stroke-w=
idth=3D"1.5" stroke-linecap=3D"round" stroke-linejoin=3D"round"></path>
                <path d=3D"M16 6.66602L25.3333 15.9993L16 25.3327" stroke=
