%, -50%); border: 5px solid rgb(21, 21, 21); border-radius: 50%; }

.center1 { width: 200px; height: 200px; border-left-color: var(--color-prim=
ary1); border-top-color: var(--color-primary1); animation: 2s linear 0s inf=
inite normal none running animateCenter1; }

