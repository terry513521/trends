 d-block mx-auto mb-3" width=3D"120" height=3D"120">
                    <h3>Read</h3>
                    <div class=3D"code-box">
                        <p>db.collection(=E2=80=98users=E2=80=99).find({ ag=
e: { $gte: 18 } }).toArray((err, users) =3D&gt; {</p>
                        <p>&nbsp;&nbsp;if (err) throw err;</p>
                        <p>&nbsp;&nbsp;console.log(=E2=80=98Adult users:=E2=
=80=99, users);</p>
