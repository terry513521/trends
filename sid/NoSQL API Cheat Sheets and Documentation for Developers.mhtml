: none; color: rgb(68, 68, 68); display: block; font-size: 1em; height: aut=
o; left: 5px; line-height: normal; padding: 15px 23px 14px; text-decoration=
: none; top: 5px; width: auto; z-index: 100000; clip: auto !important; }

.loader { background: rgb(255, 255, 255); z-index: 99999; width: 100%; heig=
ht: 100%; position: fixed; left: 0px; }

